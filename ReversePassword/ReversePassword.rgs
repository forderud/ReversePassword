HKCR
{
    NoRemove CLSID
    {
        ForceRemove {ACA40B06-9A9A-4B7B-A92C-F97FED8403B6} = s 'ReversePassword Credential Provider'
        {
            InprocServer32 = s '%MODULE%'
            {
                val ThreadingModel = s 'Both'
            }
        }
    }
}

HKLM
{
    NoRemove SOFTWARE
    {
        NoRemove Microsoft
        {
            NoRemove Windows
            {
                NoRemove CurrentVersion
                {
                    NoRemove Authentication
                    {
                        NoRemove 'Credential Providers'
                        {
                            ForceRemove {ACA40B06-9A9A-4B7B-A92C-F97FED8403B6} = s 'ReversePassword'
                        }
                    }
                }
            }
        }
    }
}
